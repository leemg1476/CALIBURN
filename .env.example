# Replace with a strong unique random token. Never commit a real value.
CALIBURN_API_TOKEN=replace-with-long-random-secret
# fixture is OFFLINE TEST ONLY. Use openai_compatible for actual LLMs.
CALIBURN_PROVIDER=fixture
CALIBURN_MODEL=caliburn-agent
CALIBURN_UPSTREAM_MODEL=your-local-model-name
CALIBURN_UPSTREAM_BASE_URL=http://127.0.0.1:8001/v1
CALIBURN_UPSTREAM_API_KEY=
# Optional HOST backend profile; ignored file, never agent/sandbox mount or image COPY.
# Explicit upstream environment entries above override file values; omit them to use file.
# CALIBURN_API_ENV_FILE=.env.apikey
# Loading a file does not enable a provider; live calls require separate opt-in/policy.
CALIBURN_MAX_STEPS=6
CALIBURN_DB_PATH=./.caliburn/data.sqlite3
CALIBURN_ALLOW_COMMERCIAL_FALLBACK=false
# M1 uses a separate PostgreSQL database; no automatic M0 SQLite import.
CALIBURN_DATABASE_URL=postgresql+psycopg://caliburn:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/caliburn
# Separate migration/bootstrap administrator; never passed to API or worker.
CALIBURN_DB_ADMIN_PASSWORD=replace-with-admin-secret
CALIBURN_DB_PASSWORD=replace-with-runtime-secret
CALIBURN_MAX_OUTPUT_TOKENS=1024
# Positive conservative per-call reservation required with upstream providers.
CALIBURN_MODEL_CALL_COST=0
CALIBURN_TASK_MAX_COST=0
# Opt-in for NEW tasks: inert capability proposals only, no execution/promotion.
CALIBURN_ALLOW_CAPABILITY_PROPOSALS=false
CALIBURN_ALLOW_CAPABILITY_CHECKS=false
CALIBURN_ALLOW_FACTORY_EXECUTION=false
# Opt-in: new tasks may pin already approved internal pure-JSON releases.
CALIBURN_ALLOW_REGISTRY_INVOCATION=false
