# Review-gated development image; not approved for customer redistribution.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ARG CALIBURN_ALLOW_GIT_DEV_IMAGE=false
ARG GIT_DEBIAN_VERSION=1:2.47.3-0+deb13u1
RUN test "$CALIBURN_ALLOW_GIT_DEV_IMAGE" = true && test -n "$GIT_DEBIAN_VERSION" \
    && apt-get update \
    && apt-get install --yes --no-install-recommends "git=$GIT_DEBIAN_VERSION" \
    && dpkg-query -W > /opt/git-image-packages.txt \
    && cp /usr/share/doc/git/copyright /opt/git-copyright \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin runner
COPY src/caliburn/sandbox/runner.py /opt/runner.py
COPY src/caliburn/sandbox/git_workspace.py /opt/git_workspace.py
COPY src/caliburn/sandbox/git_runner.py /opt/git_runner.py
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "-I", "-B", "/opt/git_runner.py"]
